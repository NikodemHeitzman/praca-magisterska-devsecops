# Copy to app/.env and fill in. Never commit .env (AGENTS.md, rule 4).
# Used by compose.yaml (variable substitution) and by the app (pydantic-settings).

# PostgreSQL in compose.yaml; keep the password in DATABASE_URL in sync.
# 127.0.0.1, not localhost: compose publishes the ports on IPv4 only, and localhost may
# resolve to ::1 first, so every new connection waits for a timeout.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ticketing:change-me@127.0.0.1:5432/ticketing

# Token signing key, at least 32 random bytes, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=30

# Comma-separated list of allowed origins (GT-12).
CORS_ORIGINS=http://localhost:8000

# Attachments: moto from compose.yaml locally; leave S3_ENDPOINT_URL empty in AWS.
S3_BUCKET=ticketing-attachments
S3_ENDPOINT_URL=http://127.0.0.1:5000
# Dummy credentials accepted by moto; in AWS the app uses its IAM role instead.
AWS_ACCESS_KEY_ID=moto
AWS_SECRET_ACCESS_KEY=moto
AWS_DEFAULT_REGION=eu-central-1

ATTACHMENT_CACHE_DIR=./.attachment-cache
MAX_UPLOAD_BYTES=5242880
ALLOWED_CONTENT_TYPES=text/plain,application/pdf,image/png,image/jpeg

LOG_LEVEL=INFO
